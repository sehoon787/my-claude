{
  "mcpServers": {
    "context7": {
      "type": "url",
      "url": "https://mcp.context7.com/mcp"
    },
    "exa": {
      "type": "url",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa"
    },
    "grep_app": {
      "type": "url",
      "url": "https://mcp.grep.app"
    },
    "serena": {
      "type": "stdio",
      "command": "serena",
      "args": ["start-mcp-server", "--context", "claude-code", "--project-from-cwd"]
    },
    "headroom": {
      "type": "stdio",
      "command": "headroom",
      "args": ["mcp", "serve"]
    }
  }
}
